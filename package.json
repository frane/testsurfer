{
  "name": "testsurfer",
  "version": "0.1.1",
  "description": "End-to-end testing for the web, driven by vibesurfer. Playwright-style locators and auto-retrying assertions over a real WebKit engine with trusted native input.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test test/wire.test.ts test/tree.test.ts test/locator.test.ts test/aria.test.ts",
    "test:e2e": "node --test test/e2e.test.ts test/features.test.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test:unit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "e2e",
    "testing",
    "browser",
    "webkit",
    "vibesurfer",
    "accessibility"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frane/testsurfer.git"
  },
  "homepage": "https://github.com/frane/testsurfer#readme",
  "bugs": {
    "url": "https://github.com/frane/testsurfer/issues"
  }
}
